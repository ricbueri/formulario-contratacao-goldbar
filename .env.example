# Destino das notificações
NOTIFY_EMAIL=ricardobueri@gmail.com

# Remetente (Resend exige domínio verificado em produção)
MAIL_FROM="Gold Bar <noreply@seudominio.com>"

# Opção A — Resend (recomendado)
# RESEND_API_KEY=re_xxxxxxxx

# Opção B — SMTP genérico (Gmail, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seu@gmail.com
# SMTP_PASS=senha-de-app

# Desenvolvimento local (padrão até configurar e-mail)
SAVE_PDF_LOCALLY=true
SKIP_EMAIL=true

# Quando for ativar e-mail: SKIP_EMAIL=false + Resend ou SMTP acima

# 3002 evita conflito com o gerador de contratos (3001)
PORT=3002

# Vercel / Netlify — configure no painel, não envie o arquivo .env
# NOTIFY_EMAIL=ricardobueri@gmail.com
# MAIL_FROM="Gold Bar <noreply@seudominio.com>"
# RESEND_API_KEY=
# SKIP_EMAIL=false
# Não use SAVE_PDF_LOCALLY na nuvem: o disco do servidor não guarda o arquivo.
